{
  "name": "@markmap/autoloader",
  "version": "1.1.1",
  "description": "One script tag that turns .markmap blocks into maps",
  "homepage": "https://github.com/markmap/markmap#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmap/markmap.git",
    "directory": "packages/autoloader"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build:types": "tsc -b",
    "build:js": "vite build"
  },
  "devDependencies": {
    "@markmap/element": "workspace:*",
    "@markmap/plugin-math": "workspace:*",
    "@markmap/render": "workspace:*",
    "@markmap/view": "workspace:*",
    "happy-dom": "^21.0.4"
  }
}
