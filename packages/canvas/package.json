{
  "name": "@markmap/canvas",
  "version": "1.0.0-next.0",
  "description": "Canvas backend for Markmap",
  "homepage": "https://github.com/markmap/markmap#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmap/markmap.git",
    "directory": "packages/canvas"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build:types": "tsc -b",
    "build:js": "vite build"
  },
  "dependencies": {
    "@markmap/core": "workspace:*",
    "@markmap/render": "workspace:*"
  },
  "devDependencies": {
    "@markmap/parse": "workspace:*",
    "@markmap/plugin-math": "workspace:*",
    "@markmap/view": "workspace:*",
    "@napi-rs/canvas": "^1.1.0",
    "happy-dom": "^21.0.4"
  },
  "peerDependencies": {
    "@markmap/view": "workspace:^",
    "@napi-rs/canvas": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@markmap/view": {
      "optional": true
    },
    "@napi-rs/canvas": {
      "optional": true
    }
  }
}
