{
  "name": "@markmap/parse",
  "version": "1.1.1",
  "description": "Parse Markdown into a Markmap tree",
  "homepage": "https://github.com/markmap/markmap#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmap/markmap.git",
    "directory": "packages/parse"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build:types": "tsc -b",
    "build:js": "vite build"
  },
  "dependencies": {
    "@markmap/core": "workspace:*",
    "micromark-util-chunked": "^2.0.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-resolve-all": "^2.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-types": "^2.0.3"
  }
}
