    "lowlight": "^3.3.0",
    "mdast-util-to-hast": "^13.2.1"
  },
  "devDependencies": {
    "@markmap/parse": "workspace:*",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "happy-dom": "^21.0.4"
