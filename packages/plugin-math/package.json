{
  "name": "@markmap/plugin-math",
  "version": "0.0.0",
  "description": "TeX math in Markmap labels, rendered with MathJax",
  "homepage": "https://github.com/markmap/markmap#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmap/markmap.git",
    "directory": "packages/plugin-math"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build:types": "tsc -b",
    "build:js": "vite build"
  },
  "dependencies": {
    "@markmap/core": "workspace:*",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "mdast-util-math": "^3.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@markmap/parse": "workspace:*",
    "@markmap/render": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4"
  }
}
