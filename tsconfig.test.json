{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@markmap/canvas/node": ["./packages/canvas/src/node.ts"],
      "@markmap/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "playground", "packages/*/vite.config.ts", "vitest.config.ts"]
}
