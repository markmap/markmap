{
  "name": "@markmap/cli",
  "version": "1.1.0",
  "description": "Turn Markdown into a map from the command line",
  "homepage": "https://github.com/markmap/markmap#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmap/markmap.git",
    "directory": "packages/cli"
  },
  "bin": {
    "markmap": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build:types": "tsc -b",
    "build:js": "vite build"
  },
  "dependencies": {
    "@markmap/canvas": "workspace:*",
    "@markmap/core": "workspace:*",
    "@markmap/page": "workspace:*",
    "@markmap/parse": "workspace:*",
    "@markmap/plugin-math": "workspace:*",
    "@markmap/render": "workspace:*"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
