{
  "name": "markmap",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite playground",
    "build": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm clean && pnpm build:types && pnpm build:js && pnpm test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "pnpm -r clean",
    "build:types": "tsc -b",
    "build:js": "pnpm -r build:js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
